<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/device_control_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:title="Contrôle Microphone"
        app:navigationIcon="@drawable/ic_baseline_arrow_back_24"
        app:titleCentered="true" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="?attr/actionBarSize"
        android:padding="16dp">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/deviceName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Appareil : inconnu"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:paddingBottom="12dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                android:layout_marginBottom="16dp"
                app:cardElevation="4dp"
                android:padding="16dp">

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal">

                    <ImageView
                        android:id="@+id/microphoneIcon"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:src="@drawable/mic_on"
                        android:contentDescription="Icône micro"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/statusText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Statut : inconnu"
                        android:textAppearance="?attr/textAppearanceBody1"
                        android:layout_marginBottom="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/muteButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mute"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_margin="6dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/unmuteButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Unmute"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_margin="6dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:padding="12dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/audioInputState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Audio Input State : N/A"
                        android:paddingBottom="6dp" />

                    <TextView
                        android:id="@+id/gainSettings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gain Settings : N/A"
                        android:paddingBottom="6dp" />

                    <TextView
                        android:id="@+id/audioInputType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Audio Input Type : N/A"
                        android:paddingBottom="6dp" />

                    <TextView
                        android:id="@+id/audioInputStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Audio Input Status : N/A"
                        android:paddingBottom="6dp" />

                    <TextView
                        android:id="@+id/audioInputDescription"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Audio Input Description : N/A"
                        android:paddingBottom="6dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/disconnectButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Déconnexion / Recommencer"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
